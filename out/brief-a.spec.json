   },
   {
    "outcome": "not_reached",
    "reason": "callback",
    "when": "callback scheduled; rule 6"
   },
   {
    "outcome": "not_reached",
    "reason": "no_callback",
    "when": "second proposal outside window; rule 7"
   },
   {
    "outcome": "not_reached",
    "reason": "wrong_number",
    "when": "number not the customer's; rule 8"
   },
   {
    "outcome": "not_reached",
    "reason": "deceased",
    "when": "customer has died; rule 9"
   },
   {
    "outcome": "not_verified",
    "reason": "failed",
    "when": "three wrong answers; rule 14"
   },
   {
    "outcome": "not_verified",
    "reason": "declined",
    "when": "second refusal; twice no talk, before verification; rule 15"
   },
   {
    "outcome": "no_promise",
    "reason": "refused",
    "when": "attempts used up; twice no talk, verified; rules 31 and 45"
   },
   {
    "outcome": "transferred",
    "reason": "support",
    "when": "hardship, accepts transfer; rule 32"
   },
   {
    "outcome": "no_promise",
    "reason": "hardship",
    "when": "hardship, declines transfer; rule 32"
   },
   {
    "outcome": "no_promise",
    "reason": "service_error",
    "when": "create_promise fails twice; rule 37"
   },
   {
    "outcome": "paid",
    "reason": "",
    "when": "customer already paid; rule 39"
   },
   {
    "outcome": "no_promise",
    "reason": "dispute",
    "when": "debt disputed; rule 40"
   },
   {
    "outcome": "transferred",
    "reason": "restructuring",
    "when": "plan request; rule 41"
   },
   {
    "outcome": "transferred",
    "reason": "human",
    "when": "insists on human; rule 42"
   },
   {
    "outcome": "promise",
    "reason": "",
    "when": "at least one promise was recorded"
   }
  ],
  "verbatim": [
   {
    "text": "Am I speaking with {title} {last_name}?",
    "when": "R08: Ask \"Am I speaking with {title} {last_name}?\"."
   },
   {
    "text": "I am sorry for your loss.",
    "when": "R15: If told the customer has died, say \"I am sorry for your loss.\", ask nothing else, close `not_reached` / `deceased`."
   },
   {
    "text": "Can you make this payment today?",
    "when": "R36: First ask: \"Can you make this payment today?\"."
   },
   {
    "text": "Do you confirm?",
    "when": "R42: Read product, amount and date back and ask \"Do you confirm?\". Call `create_promise` only after a clear yes."
   },
   {
    "text": "You will receive a text message confirming this promise.",
    "when": "R46: After a recorded promise, say the confirmation text sentence."
   }
  ],
