   {
    "product_types": [
     "personal_loan",
     "car_loan"
    ],
    "rule": {
     "type": "field",
     "field": "instalment_amount"
    }
   }
  ],
  "attempt_ladder": [
   {
    "attempt": 1,
    "bands": [],
    "amount": "in_play",
