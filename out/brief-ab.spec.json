   },
   {
    "outcome": "not_reached",
    "reason": "callback",
    "when": "callback scheduled; rule 6"
   },
   {
    "outcome": "not_reached",
    "reason": "no_callback",
    "when": "second offer outside window; rule 7"
   },
   {
    "outcome": "not_reached",
    "reason": "wrong_number",
    "when": "number not the customer's; rule 8"
   },
   {
    "outcome": "not_reached",
    "reason": "deceased",
    "when": "customer died; rule 9"
   },
   {
    "outcome": "not_verified",
    "reason": "failed",
    "when": "three wrong answers; rule 14"
   },
   {
    "outcome": "not_verified",
    "reason": "declined",
    "when": "second refusal; twice unwilling, before verification; rule 15"
   },
   {
    "outcome": "no_promise",
    "reason": "refused",
    "when": "attempts used up; twice unwilling, after verification; first non-paid note is refused; rules 31, 45"
   },
   {
    "outcome": "transferred",
    "reason": "support",
    "when": "accepts support; rule 32"
   },
   {
    "outcome": "no_promise",
    "reason": "hardship",
    "when": "declines support; first non-paid note is hardship"
   },
   {
    "outcome": "paid",
    "reason": "",
    "when": "customer says already paid; no promise and every product noted paid"
   },
   {
    "outcome": "no_promise",
    "reason": "dispute",
    "when": "customer disputes the debt; first non-paid note is dispute"
   },
   {
    "outcome": "transferred",
    "reason": "human",
    "when": "customer insists on a human; rule 42"
   },
   {
    "outcome": "transferred",
    "reason": "restructuring",
    "when": "restructuring request; rule 41 / B rule 10"
   },
   {
    "outcome": "promise",
    "reason": "",
    "when": "at least one promise recorded, unless restructuring transfer"
   },
   {
    "outcome": "no_promise",
    "reason": "service_error",
    "when": "first non-paid note is service_error"
   }
  ],
  "note_reasons": [
   {
    "reason": "refused",
    "when": "product refused"
   },
   {
    "reason": "hardship",
    "when": "hardship"
   },
   {
    "reason": "dispute",
    "when": "disputed"
   },
   {
    "reason": "paid",
    "when": "already paid"
   },
   {
    "reason": "service_error",
    "when": "create_promise failed twice"
   }
  ],
  "verbatim": [
   {
    "text": "Am I speaking with {title} {last_name}?",
    "when": "R08: Ask \"Am I speaking with {title} {last_name}?\"."
   },
   {
    "text": "I am sorry for your loss.",
    "when": "R15: If told the customer has died, say \"I am sorry for your loss.\", ask nothing else, close `not_reached` / `deceased`."
   },
   {
    "text": "You will receive a text message confirming this promise.",
    "when": "R47: After a recorded promise, say the mandatory confirmation-text sentence."
   },
   {
    "text": "Do you confirm?",
    "when": "R67: Brief B: read all promises (product, amount, date) back together and ask \"Do you confirm?\" once; after a clear yes call `create_promise` once per product."
   }
  ],
