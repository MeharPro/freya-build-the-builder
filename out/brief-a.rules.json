  "id": "R26",
  "source": "brief-a.md rule 18 table",
  "category": "dates",
  "text": "Deadline by `days_late`: 1-7 early, 12th business day after today, 1 attempt; 8-45 late, 7th business day after today, 2 attempts.",
  "verbatim": [],
  "values": {
   "bands": [
    {
     "name": "early",
     "min_days": 1,
